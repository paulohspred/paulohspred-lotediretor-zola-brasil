          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "database": "ok",
                    "service": "platform-api",
                    "status": "ok",
                    "version": "0.1.0"
                  }
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Platform API liveness/readiness status",
