<section class="callout" data-test-terrain-analysis {{did-insert this.load}} {{did-update this.load @propertyId @materializationState.status}} {{will-destroy this.invalidate}}>
  <h4>Topografia do terreno</h4>
  {{#if this.processing}}<p class="text-small" data-test-terrain-processing>Processando modelo altimétrico do terreno…</p>
  {{else if this.failed}}<p class="text-small">Não foi possível concluir a topografia automática.</p><button class="button tiny" type="button" {{on "click" this.retry}}>Tentar novamente</button>
  {{else if this.errorMessage}}<p class="text-small alert">{{this.errorMessage}}</p>
  {{else if this.displayRows.length}}
    <div class="grid-x grid-margin-x small-up-1 medium-up-2">{{#each this.displayRows as |row|}}<div class="cell" data-test-terrain-row={{row.evidenceType}}><strong>{{row.label}}</strong><div>{{row.valueText}}{{#if row.unit}} {{row.unit}}{{/if}}</div></div>{{/each}}</div>
    {{#if this.manifestHash}}
      <p class="text-small medium-gray">Modelo versionado · manifesto SHA-256 <code>{{this.manifestHash}}</code></p>
    {{/if}}
    <p class="text-small medium-gray">As cotas são calculadas a partir do modelo digital de terreno municipal de 2020 recortado pela geometria versionada do lote. A declividade exibida é o gradiente global do plano de melhor ajuste; não representa a maior declividade local nem substitui levantamento topográfico de campo.</p>
  {{/if}}
</section>
