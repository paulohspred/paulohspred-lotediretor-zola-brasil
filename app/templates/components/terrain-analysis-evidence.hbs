<section
  class="callout"
  data-test-terrain-analysis
  {{did-insert this.load}}
  {{did-update this.load @propertyId @materializationState.status}}
  {{will-destroy this.invalidate}}
>
  <h4>Topografia do terreno</h4>
  {{#if this.processing}}
    <p class="text-small" data-test-terrain-processing>Processando superfície, declividades e curvas do terreno…</p>
  {{else if this.failed}}
    <p class="text-small">Não foi possível concluir a topografia automática.</p>
    <button class="button tiny" type="button" {{on "click" this.retry}}>Tentar novamente</button>
  {{else if this.errorMessage}}
    <p class="text-small alert">{{this.errorMessage}}</p>
  {{else if this.displayRows.length}}
    <div class="grid-x grid-margin-x small-up-1 medium-up-2">
      {{#each this.displayRows as |row|}}
        <div class="cell" data-test-terrain-row={{row.evidenceType}}>
          <strong>{{row.label}}</strong>
          <div>{{row.valueText}}{{#if row.unit}} {{row.unit}}{{/if}}</div>
        </div>
      {{/each}}
    </div>

    {{#if this.surfaceSummary}}
      <div class="callout secondary text-small" data-test-terrain-map-controls>
        <strong>Superfície do terreno no mapa</strong>
        <div>Grade de {{this.surfaceSummary.gridResolutionM}} m · {{this.surfaceSummary.triangleCount}} células TIN</div>
        <label>
          <input type="checkbox" checked={{this.showSlopeSurface}} {{on "change" this.toggleSlopeSurface}} />
          Declividade derivada
        </label>
        <label>
          <input type="checkbox" checked={{this.showContours}} {{on "change" this.toggleContours}} />
          Curvas derivadas
        </label>
        <label>
          <input type="checkbox" checked={{this.showHydrology}} {{on "change" this.toggleHydrology}} />
          Escoamento e sub-bacias
        </label>
        <label>
          <input type="checkbox" checked={{this.showAccess}} {{on "change" this.toggleAccess}} />
          Greide e acesso preliminar
        </label>
        <label>
          Intervalo das curvas
          <select data-test-terrain-contour-interval {{on "change" this.changeContourInterval}}>
            <option value="0.5" selected={{eq this.contourInterval "0.5"}}>0,5 m</option>
            <option value="1" selected={{eq this.contourInterval "1"}}>1 m</option>
            <option value="2" selected={{eq this.contourInterval "2"}}>2 m</option>
            <option value="5" selected={{eq this.contourInterval "5"}}>5 m</option>
          </select>
        </label>
      </div>
    {{/if}}

    {{#if this.accessSummary}}
      <div class="callout secondary text-small" data-test-terrain-access>
        <strong>Greide viário e acesso preliminar</strong>
        {{#if this.accessSummary.available}}
          <div>{{this.accessSummary.street}} · eixo–divisa {{this.accessSummary.centerlineDistanceM}} m</div>
          <div>Divisa {{this.accessSummary.lotBoundaryElevationM}} m · eixo viário {{this.accessSummary.streetAxisElevationM}} m · lote {{this.accessSummary.relativePosition}}</div>
          <div>Conexão reta preliminar {{this.accessSummary.straightGradePercent}}% · perfil viário {{this.accessSummary.profileLengthM}} m</div>
          <div>Greide absoluto local: mediana {{this.accessSummary.medianGradePercent}}% · P95 {{this.accessSummary.p95GradePercent}}% · máximo {{this.accessSummary.maxGradePercent}}%</div>
          <p>Triagem geométrica pelo MDT e eixo viário cadastral. Não representa cota levantada de guia/sarjeta, posição legal de acesso, projeto de rampa, calçada ou aprovação viária.</p>
        {{else}}
          <div>{{this.accessSummary.reason}}</div>
        {{/if}}
      </div>
    {{/if}}

    {{#if this.streetProfileDiagram}}
      <div class="callout secondary" data-test-terrain-street-profile>
        <strong>{{this.streetProfileDiagram.label}}</strong>
        <div class="text-small">{{this.streetProfileDiagram.lengthM}} m · greide líquido geométrico {{this.streetProfileDiagram.netGradePercent}}%</div>
        <svg viewBox="0 0 320 120" role="img" aria-label={{this.streetProfileDiagram.label}}>
          <line x1="14" y1="106" x2="306" y2="106" stroke="currentColor" stroke-width="0.6"></line>
          <line x1="14" y1="14" x2="14" y2="106" stroke="currentColor" stroke-width="0.6"></line>
          <polyline points={{this.streetProfileDiagram.points}} fill="none" stroke="currentColor" stroke-width="2"></polyline>
          <text x="18" y="24" font-size="9">{{this.streetProfileDiagram.maxElevationM}} m</text>
          <text x="18" y="102" font-size="9">{{this.streetProfileDiagram.minElevationM}} m</text>
        </svg>
      </div>
    {{/if}}

    {{#if this.hydrologySummary}}
      <div class="callout secondary text-small" data-test-terrain-hydrology>
        <strong>Drenagem preliminar do terreno</strong>
        <div>Direção preferencial {{this.hydrologySummary.direction}} · {{this.hydrologySummary.basinCount}} sub-bacias · {{this.hydrologySummary.outletCount}} saídas</div>
        <div>Sub-bacia principal ~{{this.hydrologySummary.mainAreaM2}} m² · saída principal {{this.hydrologySummary.outletElevationM}} m</div>
        <div>Depressão máxima para roteamento {{this.hydrologySummary.depressionDepthM}} m · volume equivalente {{this.hydrologySummary.depressionVolumeM3}} m³</div>
        <p>Triagem derivada apenas do relevo. Não considera chuva de projeto, infiltração, tubulações, meio-fio, muros, pavimentação ou futura terraplenagem.</p>
      </div>
    {{/if}}

    {{#if this.cursorSample}}
      <div class="callout primary text-small" data-test-terrain-cursor-sample>
        <strong>Cota sob o cursor</strong>
        <div>{{this.cursorSample.elevationM}} m · declividade da célula {{this.cursorSample.slopePercent}}%</div>
        <div>{{this.cursorSample.latitude}}, {{this.cursorSample.longitude}}</div>
      </div>
    {{/if}}

    {{#if this.profileDiagrams.length}}
      <div class="grid-x grid-margin-x small-up-1 medium-up-2" data-test-terrain-profiles>
        {{#each this.profileDiagrams as |profile|}}
          <div class="cell">
            <div class="callout secondary">
              <strong>{{profile.label}}</strong>
              <div class="text-small">{{profile.lengthM}} m · greide líquido {{profile.netGradePercent}}%</div>
              <svg viewBox="0 0 320 120" role="img" aria-label={{profile.label}} data-test-terrain-profile={{profile.id}}>
                <line x1="14" y1="106" x2="306" y2="106" stroke="currentColor" stroke-width="0.6"></line>
                <line x1="14" y1="14" x2="14" y2="106" stroke="currentColor" stroke-width="0.6"></line>
                <polyline points={{profile.points}} fill="none" stroke="currentColor" stroke-width="2"></polyline>
                <text x="18" y="24" font-size="9">{{profile.maxElevationM}} m</text>
                <text x="18" y="102" font-size="9">{{profile.minElevationM}} m</text>
              </svg>
            </div>
          </div>
        {{/each}}
      </div>
    {{/if}}

    {{#if this.manifestHash}}
      <p class="text-small medium-gray">Modelo versionado · manifesto SHA-256 <code>{{this.manifestHash}}</code></p>
    {{/if}}
    {{! template-lint-disable no-whitespace-within-word }}
    <p class="text-small medium-gray">As cotas e a superfície são derivadas do modelo digital de terreno de 2020 recortado pela geometria versionada do lote. A declividade média global vem de um plano de melhor ajuste. P95, distribuição e maior amostra local são derivados de uma grade de 1 m e são sensíveis à microtopografia; a maior amostra não deve ser usada isoladamente como declividade de projeto. Estes resultados não substituem levantamento planialtimétrico de campo.</p>
  {{/if}}
</section>
