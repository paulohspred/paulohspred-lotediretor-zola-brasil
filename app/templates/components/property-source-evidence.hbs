<section
  data-test-property-source-evidence
  {{did-insert this.load}}
  {{did-update this.load @propertyId}}
>
  <h3 class="header-medium">Identidade cadastral versionada</h3>
  {{#if this.loading}}
    <p class="text-small">Consultando evidência do imóvel na Platform API…</p>
  {{else if this.errorMessage}}
    <p class="callout warning text-small" data-test-property-evidence-error>
      A evidência versionada do imóvel está temporariamente indisponível. O relatório atual continua operando.
    </p>
  {{else if this.evidence}}
    <div class="callout secondary text-small" data-test-property-evidence>
      <strong>GeoSampa — lote {{this.evidence.valueText}}</strong>
      <div>Status: {{this.evidence.statusLabel}}</div>
      <div>Fonte: {{this.evidence.snapshot.authority}}</div>
      <div>Snapshot SHA-256: <code>{{this.evidence.snapshot.sha256}}</code></div>
      {{#if this.citation.sourceUrl}}
        <div>
          <a href={{this.citation.sourceUrl}} target="_blank" rel="noopener noreferrer">
            Abrir consulta oficial capturada
          </a>
        </div>
      {{/if}}
    </div>
    <p class="text-small">
      Esta evidência confirma o identificador cadastral publicado pelo GeoSampa. Não comprova propriedade dominial nem substitui certidão ou matrícula.
    </p>
  {{else}}
    <p class="callout secondary text-small" data-test-property-evidence-empty>
      Ainda não há snapshot versionado do GeoSampa para este imóvel. O relatório atual permanece disponível abaixo.
    </p>
  {{/if}}
</section>
