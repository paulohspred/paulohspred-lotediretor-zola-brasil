<Deprecated::SiteHeader
  @responsiveNav={{true}}
  @betaNotice={{false}}
  class={{if this.printSvc.enabled "hide-for-print"}} as |banner|
>
  <banner.title>
    <LinkTo @route="index" @query={{hash print=false}} class="site-title" data-test-link-to="index">
      LoteDiretor
      <small class="site-subtitle show-for-medium">Brasil · Inteligência Territorial e Urbanística</small>
    </LinkTo>
  </banner.title>
  <banner.nav>
    <ul class="menu vertical large-horizontal">
      <li><LinkTo @route="imovel-360">Imóvel 360</LinkTo></li>
      <li><LinkTo @route="plano-diretor">Plano Diretor</LinkTo></li>
      <li><LinkTo @route="rural">Rural</LinkTo></li>
      <li><LinkTo @route="condominio">Condomínio</LinkTo></li>
      <li><LinkTo @route="solar">Solar</LinkTo></li>
      <li><LinkTo @route="ai-tec">A.I TEC</LinkTo></li>
      <li><LinkTo @route="prefeitura">Prefeitura</LinkTo></li>
      <li class="saved-bookmarks-counter">
        <LinkTo @route="mais">Mais
          {{#if this.totalBookmarks}}<span class="badge sup">{{this.totalBookmarks}}</span>{{/if}}
        </LinkTo>
      </li>
    </ul>
  </banner.nav>
</Deprecated::SiteHeader>
