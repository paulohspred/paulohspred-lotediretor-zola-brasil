<header
  class="site-header {{if this.printSvc.enabled "hide-for-print"}}"
>
  <div class="grid-x grid-padding-x align-middle">
    <div class="branding cell auto">
      <span class="site-brand-row">
        <LinkTo
          @route="index"
          @query={{hash print=false}}
          class="site-title"
          data-test-link-to="index"
        >
          LoteDiretor
        </LinkTo>
        <span
          class="site-module-nav show-for-medium"
          aria-label="Módulos LoteDiretor"
        >
          <LinkTo @route="plano-diretor">Plano Diretor</LinkTo>
          <LinkTo @route="rural">Rural</LinkTo>
          <LinkTo @route="condominio">Condomínio</LinkTo>
          <LinkTo @route="solar">Solar</LinkTo>
          <LinkTo @route="ai-tec">A.I TEC</LinkTo>
          <LinkTo @route="prefeitura">Prefeitura</LinkTo>
        </span>
      </span>
    </div>

    <nav class="cell shrink hide-for-print" aria-label="Navegação principal">
      <ul class="menu vertical large-horizontal">
        <li><LinkTo @route="about">Sobre</LinkTo></li>
        <li><LinkTo @route="features" class="features-header-link">Recursos</LinkTo></li>
        <li><LinkTo @route="data">Dados</LinkTo></li>
        <li class="saved-bookmarks-counter">
          <LinkTo @route="bookmarks"><FaIcon @icon="bookmark" /> Salvos
            {{#if this.totalBookmarks}}<span class="badge sup">{{this.totalBookmarks}}</span>{{/if}}
          </LinkTo>
        </li>
      </ul>
    </nav>
  </div>
</header>
