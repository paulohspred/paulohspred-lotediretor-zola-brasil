<section data-test-legal-source-evidence {{did-insert this.load}}>
  <h3 class="header-medium">Base legal versionada</h3>
  {{#if this.loading}}
    <p class="text-small">Carregando registro jurídico do LoteDiretor…</p>
  {{else if this.errorMessage}}
    <p class="callout warning text-small" data-test-platform-evidence-error>
      A proveniência versionada está temporariamente indisponível. Mapa e relatório atual continuam operando.
    </p>
  {{else if this.evidence}}
    <div class="callout secondary text-small" data-test-platform-evidence>
      <strong>{{this.evidence.valueText}}</strong>
      <div>Registro LoteDiretor versionado</div>
      <div>Status: {{this.evidence.statusLabel}}</div>
      <div>Snapshot SHA-256: <code>{{this.evidence.snapshot.sha256}}</code></div>
    </div>
    <p class="text-small">
      Esta evidência confirma somente a identidade do documento capturado. Ela não afirma, por si só, quais parâmetros legais se aplicam ao imóvel ativo.
    </p>
  {{else}}
    <p class="callout secondary text-small" data-test-platform-evidence-empty>
      Ainda não há evidência legal versionada disponível.
    </p>
  {{/if}}
</section>
