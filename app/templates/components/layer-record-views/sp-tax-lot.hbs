<label class="header-label clearfix">
  {{#if @comparisonMode}}
    {{#if @otherModelId}}
      <button
        class="float-right"
        style="color: #ae561f;"
        type="button"
        {{on "click" this.removeComparisonLot}}
        title="Remover este lote da comparação"
      >
        <FaIcon @icon="times" />
      </button>
    {{/if}}
  {{else}}
    <button
      class="add-comparison-lot-button show-for-medium"
      type="button"
      {{on "click" this.compareLot}}
    >
      <FaIcon @icon="plus" />
      Comparar com outro lote
    </button>
    <br />
  {{/if}}
  LOTE FISCAL
  <span class="medium-gray">|</span>
  LOTEDIRETOR
  <span data-test-sp-lot-id>{{@model.cd_identificador}}</span>
</label>

<h1 class="content-header">
  <span class="address">
    {{@model.nm_logradouro_completo}}
    {{#if @model.cd_numero_porta}}, {{@model.cd_numero_porta}}{{/if}}
  </span>
</h1>

{{#if @model.tx_complemento_endereco}}
  <p class="text-small dark-gray" style="margin-bottom: 0.5rem">
    {{@model.tx_complemento_endereco}}
  </p>
{{/if}}

<p class="text-small dark-gray" style="margin-bottom: 1rem">
  Setor {{@model.cd_setor_fiscal}}
  <span class="pipe">|</span>
  Quadra {{@model.cd_quadra_fiscal}}
  <span class="pipe">|</span>
  Lote {{@model.cd_lote}}
  {{#if @model.cd_digito_sql}}
    <span class="pipe">|</span>
    Dígito {{@model.cd_digito_sql}}
  {{/if}}
</p>

<section class="lot-details">
  <div class="data-grid">
    <label class="data-label">Identificador territorial</label>
    <span class="datum">{{@model.cd_identificador}}</span>
  </div>

  {{#if @model.cd_identificador_original_lote}}
    <div class="data-grid">
      <label class="data-label">Identificador original</label>
      <span class="datum">{{@model.cd_identificador_original_lote}}</span>
    </div>
  {{/if}}

  {{#if @model.tx_situ_lote}}
    <div class="data-grid">
      <label class="data-label">Situação do lote</label>
      <span class="datum">{{@model.tx_situ_lote}}</span>
    </div>
  {{/if}}

  {{#if @model.tx_tipo_lote}}
    <div class="data-grid">
      <label class="data-label">Tipo de lote</label>
      <span class="datum">{{@model.tx_tipo_lote}}</span>
    </div>
  {{/if}}

  {{#if @model.tpcl.tipoUso}}
    <div class="data-grid">
      <label class="data-label">Uso fiscal detalhado</label>
      <span class="datum">{{@model.tpcl.tipoUso}}</span>
    </div>
  {{else if @model.dc_tipo_uso_imovel}}
    <div class="data-grid">
      <label class="data-label">Uso do imóvel</label>
      <span class="datum">{{@model.dc_tipo_uso_imovel}}</span>
    </div>
  {{/if}}

  {{#if @model.tpcl.tipoTerreno}}
    <div class="data-grid">
      <label class="data-label">Tipo de terreno — IPTU</label>
      <span class="datum">{{@model.tpcl.tipoTerreno}}</span>
    </div>
  {{/if}}

  {{#if @model.tpcl.condominio}}
    <div class="data-grid">
      <label class="data-label">Código de condomínio — IPTU</label>
      <span class="datum">{{@model.tpcl.condominio}}</span>
    </div>
  {{/if}}

  {{#if @model.qt_area_terreno}}
    <div class="data-grid">
      <label class="data-label">Área do terreno</label>
      <span class="datum">{{numeral-format @model.qt_area_terreno "0,0.[00]"}} m²</span>
    </div>
  {{/if}}

  {{#if @model.qt_area_construida}}
    <div class="data-grid">
      <label class="data-label">Área construída</label>
      <span class="datum">{{numeral-format @model.qt_area_construida "0,0.[00]"}} m²</span>
    </div>
  {{/if}}

  {{#if @model.cd_cib}}
    <div class="data-grid">
      <label class="data-label">CIB</label>
      <span class="datum">{{@model.cd_cib}}</span>
    </div>
  {{/if}}

  {{#if @model.tx_situacao_cib}}
    <div class="data-grid">
      <label class="data-label">Situação CIB</label>
      <span class="datum">{{@model.tx_situacao_cib}}</span>
    </div>
  {{/if}}
</section>

{{#if @model.iptuAnual.available}}
  <hr class="hide-for-print" />
  <section class="annual-property-tax">
    <h3 class="header-small lot-section-header">
      Cadastro fiscal — IPTU {{@model.iptuAnual.exercicio}}
    </h3>
    <p class="text-small dark-gray">
      Emissão Geral anual da Secretaria Municipal da Fazenda, vinculada ao SQL do imóvel.
    </p>

    <div class="data-grid">
      <label class="data-label">Inscrição municipal (SQL)</label>
      <span class="datum">{{@model.iptuAnual.sql}}</span>
    </div>
    {{#if @model.iptuAnual.dataCadastramento}}
      <div class="data-grid">
        <label class="data-label">Data do cadastramento</label>
        <span class="datum">{{@model.iptuAnual.dataCadastramento}}</span>
      </div>
    {{/if}}
    {{#if @model.iptuAnual.codlog}}
      <div class="data-grid">
        <label class="data-label">CODLOG</label>
        <span class="datum">{{@model.iptuAnual.codlog}}</span>
      </div>
    {{/if}}
    {{#if @model.iptuAnual.bairro}}
      <div class="data-grid">
        <label class="data-label">Bairro fiscal</label>
        <span class="datum">{{@model.iptuAnual.bairro}}</span>
      </div>
    {{/if}}
    {{#if @model.iptuAnual.cep}}
      <div class="data-grid">
        <label class="data-label">CEP</label>
        <span class="datum">{{@model.iptuAnual.cep}}</span>
      </div>
    {{/if}}
    {{#if @model.iptuAnual.complemento}}
      <div class="data-grid">
        <label class="data-label">Complemento fiscal</label>
        <span class="datum">{{@model.iptuAnual.complemento}}</span>
      </div>
    {{/if}}

    <div class="data-grid">
      <label class="data-label">Testada para cálculo</label>
      <span class="datum">{{numeral-format @model.iptuAnual.testadaCalculo "0,0.[00]"}} m</span>
    </div>
    <div class="data-grid">
      <label class="data-label">Esquinas / frentes</label>
      <span class="datum">{{@model.iptuAnual.quantidadeEsquinasFrentes}}</span>
    </div>
    <div class="data-grid">
      <label class="data-label">Fração ideal</label>
      <span class="datum">{{numeral-format @model.iptuAnual.fracaoIdeal "0.[0000]"}}</span>
    </div>
    <div class="data-grid">
      <label class="data-label">Área ocupada</label>
      <span class="datum">{{numeral-format @model.iptuAnual.areaOcupada "0,0.[00]"}} m²</span>
    </div>

    {{#if @model.iptuAnual.anoConstrucao}}
      <div class="data-grid">
        <label class="data-label">Ano da construção corrigido</label>
        <span class="datum">{{@model.iptuAnual.anoConstrucao}}</span>
      </div>
    {{/if}}
    {{#if @model.iptuAnual.quantidadePavimentos}}
      <div class="data-grid">
        <label class="data-label">Pavimentos — cadastro fiscal</label>
        <span class="datum">{{@model.iptuAnual.quantidadePavimentos}}</span>
      </div>
    {{/if}}
    {{#if @model.iptuAnual.padraoConstrucao}}
      <div class="data-grid">
        <label class="data-label">Padrão construtivo</label>
        <span class="datum">{{@model.iptuAnual.padraoConstrucao}}</span>
      </div>
    {{/if}}
    {{#if @model.iptuAnual.fatorObsolescencia}}
      <div class="data-grid">
        <label class="data-label">Fator de obsolescência</label>
        <span class="datum">{{numeral-format @model.iptuAnual.fatorObsolescencia "0.[00]"}}</span>
      </div>
    {{/if}}
    {{#if @model.iptuAnual.valorM2Terreno}}
      <div class="data-grid">
        <label class="data-label">Valor fiscal unitário do terreno</label>
        <span class="datum">R$ {{numeral-format @model.iptuAnual.valorM2Terreno "0,0.00"}}/m²</span>
      </div>
    {{/if}}
    {{#if @model.iptuAnual.valorM2Construcao}}
      <div class="data-grid">
        <label class="data-label">Valor fiscal unitário da construção</label>
        <span class="datum">R$ {{numeral-format @model.iptuAnual.valorM2Construcao "0,0.00"}}/m²</span>
      </div>
    {{/if}}

    <p class="text-small medium-gray" style="margin-top: 0.75rem; margin-bottom: 0.25rem;">
      Registro fiscal integrado ao LoteDiretor.
    </p>
    <p class="text-small medium-gray" style="margin-bottom: 0.25rem;">
      {{@model.iptuAnual.note}}
    </p>
    <p class="text-small">
    </p>
  </section>
{{/if}}


{{#if @model.itbiHistorico.available}}
  <hr class="hide-for-print" />
  <section class="itbi-history">
    <h3 class="header-small lot-section-header">
      Histórico de transações e referências registrais — ITBI
    </h3>
    <p class="text-small dark-gray">
      DTIs com ITBI-IV efetivamente recolhido, pesquisadas pelo SQL do imóvel no período
      {{@model.itbiHistorico.coverage}}.
    </p>

    {{#if @model.itbiHistorico.count}}
      <p class="text-small">
        <strong>{{@model.itbiHistorico.count}}</strong>
        transação(ões) encontrada(s) para este SQL.
      </p>

      {{#each @model.itbiHistorico.transactions as |transaction|}}
        <details style="margin-bottom: 0.75rem;">
          <summary class="text-small">
            {{transaction.dataTransacao}}
            {{#if transaction.naturezaTransacao}}
              — {{transaction.naturezaTransacao}}
            {{/if}}
          </summary>

          <div style="border-left: 3px solid #ae561f; padding-left: 0.75rem; margin-top: 0.5rem;">
            {{#if transaction.valorTransacao}}
              <div class="data-grid">
                <label class="data-label">Valor declarado da transação</label>
                <span class="datum">R$ {{numeral-format transaction.valorTransacao "0,0.00"}}</span>
              </div>
            {{/if}}
            {{#if transaction.valorVenalReferencia}}
              <div class="data-grid">
                <label class="data-label">Valor Venal de Referência</label>
                <span class="datum">R$ {{numeral-format transaction.valorVenalReferencia "0,0.00"}}</span>
              </div>
            {{/if}}
            {{#if transaction.proporcaoTransmitida}}
              <div class="data-grid">
                <label class="data-label">Proporção transmitida</label>
                <span class="datum">{{numeral-format transaction.proporcaoTransmitida "0,0.[00]"}}%</span>
              </div>
            {{/if}}
            {{#if transaction.baseCalculo}}
              <div class="data-grid">
                <label class="data-label">Base de cálculo adotada</label>
                <span class="datum">R$ {{numeral-format transaction.baseCalculo "0,0.00"}}</span>
              </div>
            {{/if}}
            {{#if transaction.tipoFinanciamento}}
              <div class="data-grid">
                <label class="data-label">Financiamento</label>
                <span class="datum">{{transaction.tipoFinanciamento}}</span>
              </div>
            {{/if}}
            {{#if transaction.valorFinanciado}}
              <div class="data-grid">
                <label class="data-label">Valor financiado</label>
                <span class="datum">R$ {{numeral-format transaction.valorFinanciado "0,0.00"}}</span>
              </div>
            {{/if}}
            {{#if transaction.cartorioRegistro}}
              <div class="data-grid">
                <label class="data-label">Cartório de Registro informado</label>
                <span class="datum">{{transaction.cartorioRegistro}}</span>
              </div>
            {{/if}}
            {{#if transaction.matricula}}
              <div class="data-grid">
                <label class="data-label">Matrícula informada na DTI</label>
                <span class="datum"><strong>{{transaction.matricula}}</strong></span>
              </div>
            {{/if}}
            {{#if transaction.situacaoSql}}
              <div class="data-grid">
                <label class="data-label">Situação do SQL na DTI</label>
                <span class="datum">{{transaction.situacaoSql}}</span>
              </div>
            {{/if}}
            <p class="text-small medium-gray" style="margin-top: 0.35rem; margin-bottom: 0;">
              Arquivo anual de pagamento: {{transaction.anoArquivo}}.
            </p>
          </div>
        </details>
      {{/each}}
    {{else}}
      <p class="text-small medium-gray">
        Nenhuma DTI com ITBI-IV recolhido foi localizada para este SQL no período
        {{@model.itbiHistorico.coverage}}.
      </p>
    {{/if}}

    <p class="text-small medium-gray" style="margin-bottom: 0.25rem;">
      {{@model.itbiHistorico.note}}
    </p>
  </section>
{{/if}}

{{#if @model.entorno}}
  <hr class="hide-for-print" />
  <section class="surroundings-analysis">
    <h3 class="header-small lot-section-header">
      Entorno, mobilidade e equipamentos
    </h3>
    <p class="text-small dark-gray">
      Equipamentos oficiais próximos ao lote, ordenados pela distância em metros no
      sistema cartográfico municipal.
    </p>

    {{#if @model.entorno.censusSector.available}}
      <div style="border: 1px solid #ddd; padding: 0.75rem; margin-bottom: 1rem;">
        <h5 style="margin-bottom: 0.4rem;">Setor Censitário 2022</h5>
        <div class="data-grid">
          <label class="data-label">Código do setor censitário</label>
          <span class="datum"><strong>{{@model.entorno.censusSector.code}}</strong></span>
        </div>
        {{#if @model.entorno.censusSector.areaSquareMeters}}
          <div class="data-grid">
            <label class="data-label">Área do setor</label>
            <span class="datum">{{numeral-format @model.entorno.censusSector.areaSquareMeters "0,0.[00]"}} m²</span>
          </div>
        {{/if}}
        <p class="text-small medium-gray" style="margin-bottom: 0;">
          Registro territorial do LoteDiretor. Este código será usado para
          associar os agregados do Censo 2022 sem inferir dados individuais.
        </p>
      </div>
    {{/if}}

    {{#each @model.entorno.sections as |nearby|}}
      <div style="margin-bottom: 1rem;">
        <h5 style="margin-bottom: 0.25rem;">{{nearby.label}}</h5>
        {{#if nearby.closest}}
          <p class="text-small" style="margin-bottom: 0.25rem;">
            Mais próximo: <strong>{{nearby.closest.name}}</strong> ·
            <strong>{{nearby.closest.distanceMeters}} m</strong>
          </p>
          <p class="text-small medium-gray" style="margin-bottom: 0.35rem;">
            {{nearby.countWithinRadius}} registro(s) localizado(s) em um raio de
            {{nearby.radiusMeters}} m.
          </p>
          <details style="margin-bottom: 0.5rem;">
            <summary class="text-small">Ver mais próximos</summary>
            {{#each nearby.nearest as |place|}}
              <div style="border-left: 3px solid #ae561f; padding-left: 0.75rem; margin-top: 0.5rem; margin-bottom: 0.65rem;">
                <strong>{{place.name}}</strong>
                <span class="medium-gray"> · {{place.distanceMeters}} m</span>
                {{#each place.details as |detail|}}
                  <div class="data-grid">
                    <label class="data-label">{{detail.label}}</label>
                    <span class="datum">{{detail.value}}</span>
                  </div>
                {{/each}}
              </div>
            {{/each}}
          </details>
        {{else if nearby.unavailable}}
          <p class="text-small medium-gray">Camada indisponível nesta consulta.</p>
        {{else}}
          <p class="text-small medium-gray">
            Nenhum registro localizado no raio de {{nearby.radiusMeters}} m.
          </p>
        {{/if}}
      </div>
    {{/each}}

    <p class="text-small medium-gray">
      LoteDiretor · Método: {{@model.entorno.method}} ·
      Consulta: {{@model.entorno.generatedAt}}
    </p>
  </section>
{{/if}}

{{#if @model.parametrosUrbanisticos}}
  <hr class="hide-for-print" />
  <section class="urban-parameters">
    <h3 class="header-small lot-section-header">
      Parâmetros urbanísticos — LPUOS
    </h3>
    <p class="text-small dark-gray">
      {{@model.parametrosUrbanisticos.statusLabel}} baseada no Quadro 3 da LPUOS.
      Os valores abaixo são parâmetros-base e devem ser lidos com as condicionantes
      territoriais e legais identificadas para o imóvel.
    </p>

    {{#if @model.parametrosUrbanisticos.warnings.length}}
      <div style="border-left: 3px solid #d89a2b; padding-left: 0.75rem; margin-bottom: 1rem;">
        {{#each @model.parametrosUrbanisticos.warnings as |warning|}}
          <p class="text-small" style="margin-bottom: 0.4rem;">{{warning}}</p>
        {{/each}}
      </div>
    {{/if}}

    {{#if @model.parametrosUrbanisticos.environmentalQuota.paLabel}}
      <div style="border: 1px solid #ddd; padding: 0.75rem; margin-bottom: 1rem;">
        <h5 style="margin-bottom: 0.5rem;">Quota Ambiental — Quadro 3A</h5>
        <div class="data-grid">
          <label class="data-label">Perímetro de Qualificação Ambiental</label>
          <span class="datum">{{@model.parametrosUrbanisticos.environmentalQuota.paLabel}}</span>
        </div>
        {{#if @model.parametrosUrbanisticos.environmentalQuota.tpMin}}
          <div class="data-grid">
            <label class="data-label">TP mínima-base do PA</label>
            <span class="datum">{{@model.parametrosUrbanisticos.environmentalQuota.tpMin}}</span>
          </div>
        {{/if}}
        {{#if @model.parametrosUrbanisticos.environmentalQuota.qaMinimum}}
          <div class="data-grid">
            <label class="data-label">Pontuação QA mínima</label>
            <span class="datum">{{@model.parametrosUrbanisticos.environmentalQuota.qaMinimum}}</span>
          </div>
        {{else}}
          <div class="data-grid">
            <label class="data-label">Pontuação QA mínima</label>
            <span class="datum">Isenta ou não aplicável para esta faixa/perímetro</span>
          </div>
        {{/if}}
        {{#if @model.parametrosUrbanisticos.environmentalQuota.alpha}}
          <div class="data-grid">
            <label class="data-label">Fator cobertura vegetal (α)</label>
            <span class="datum">{{@model.parametrosUrbanisticos.environmentalQuota.alpha}}</span>
          </div>
        {{/if}}
        {{#if @model.parametrosUrbanisticos.environmentalQuota.beta}}
          <div class="data-grid">
            <label class="data-label">Fator drenagem (β)</label>
            <span class="datum">{{@model.parametrosUrbanisticos.environmentalQuota.beta}}</span>
          </div>
        {{/if}}
        <p class="text-small medium-gray" style="margin-bottom: 0.25rem;">
          {{@model.parametrosUrbanisticos.environmentalQuota.note}}
        </p>
      </div>
    {{/if}}

    {{#each @model.parametrosUrbanisticos.zones as |zone|}}
      <div style="margin-bottom: 1.25rem;">
        <h5 style="margin-bottom: 0.5rem;">Zona {{zone.zoneCode}}</h5>
        <p class="text-small medium-gray">{{zone.statusLabel}}</p>

        {{#if zone.caMin}}
          <div class="data-grid">
            <label class="data-label">CA mínimo</label>
            <span class="datum">{{zone.caMin}}</span>
          </div>
        {{/if}}
        {{#if zone.caBasic}}
          <div class="data-grid">
            <label class="data-label">CA básico</label>
            <span class="datum">{{zone.caBasic}}</span>
          </div>
        {{/if}}
        {{#if zone.caMax}}
          <div class="data-grid">
            <label class="data-label">CA máximo-base</label>
            <span class="datum">{{zone.caMax}}</span>
          </div>
        {{/if}}
        {{#if zone.toMax}}
          <div class="data-grid">
            <label class="data-label">Taxa de ocupação máxima</label>
            <span class="datum">{{zone.toMax}} · {{zone.toBand}}</span>
          </div>
        {{/if}}
        {{#if zone.heightMax}}
          <div class="data-grid">
            <label class="data-label">Gabarito-base</label>
            <span class="datum">{{zone.heightMax}} m</span>
          </div>
        {{/if}}
        {{#if zone.frontSetback}}
          <div class="data-grid">
            <label class="data-label">Recuo frontal-base</label>
            <span class="datum">{{zone.frontSetback}} m</span>
          </div>
        {{/if}}
        {{#if zone.sideRearUpTo10}}
          <div class="data-grid">
            <label class="data-label">Laterais/fundos até 10 m de altura</label>
            <span class="datum">{{zone.sideRearUpTo10}} m</span>
          </div>
        {{/if}}
        {{#if zone.sideRearAbove10}}
          <div class="data-grid">
            <label class="data-label">Laterais/fundos acima de 10 m</label>
            <span class="datum">{{zone.sideRearAbove10}} m</span>
          </div>
        {{/if}}
        {{#if zone.cotaParteMax}}
          <div class="data-grid">
            <label class="data-label">Cota-parte máxima</label>
            <span class="datum">{{zone.cotaParteMax}} m²/unidade</span>
          </div>
        {{/if}}
        {{#if zone.tpMin}}
          <div class="data-grid">
            <label class="data-label">Taxa de permeabilidade mínima</label>
            <span class="datum">{{zone.tpMin}}</span>
          </div>
        {{else}}
          <div class="data-grid">
            <label class="data-label">Taxa de permeabilidade</label>
            <span class="datum">Pendente de resolver o Perímetro de Qualificação Ambiental</span>
          </div>
        {{/if}}

        {{#if zone.parcelDimensions}}
          <div style="margin-top: 0.65rem; margin-bottom: 0.5rem;">
            <strong class="text-small">Parcelamento — Quadro 2A</strong>
          </div>
          {{#if zone.parcelDimensions.minFrontage}}
            <div class="data-grid">
              <label class="data-label">Frente mínima</label>
              <span class="datum">{{zone.parcelDimensions.minFrontage}} m</span>
            </div>
          {{/if}}
          {{#if zone.parcelDimensions.minLotArea}}
            <div class="data-grid">
              <label class="data-label">Área mínima de lote</label>
              <span class="datum">{{numeral-format zone.parcelDimensions.minLotArea "0,0.[00]"}} m²</span>
            </div>
          {{/if}}
          {{#if zone.parcelDimensions.maxFrontage}}
            <div class="data-grid">
              <label class="data-label">Frente máxima</label>
              <span class="datum">{{zone.parcelDimensions.maxFrontage}} m</span>
            </div>
          {{/if}}
          {{#if zone.parcelDimensions.maxLotArea}}
            <div class="data-grid">
              <label class="data-label">Área máxima de lote</label>
              <span class="datum">{{numeral-format zone.parcelDimensions.maxLotArea "0,0.[00]"}} m²</span>
            </div>
          {{/if}}
          <p class="text-small medium-gray" style="margin-top: 0.35rem;">
            {{zone.parcelDimensions.areaRelationLabel}}.
          </p>
          <details style="margin-bottom: 0.5rem;">
            <summary class="text-small">Notas de parcelamento</summary>
            <ul class="text-small">
              {{#each zone.parcelDimensions.notes as |parcelNote|}}
                <li>{{parcelNote}}</li>
              {{/each}}
            </ul>
          </details>
        {{/if}}

        {{#if zone.notes.length}}
          <details style="margin-top: 0.5rem;">
            <summary class="text-small">Condicionantes do Quadro 3</summary>
            <ul class="text-small">
              {{#each zone.notes as |note|}}
                <li>{{note}}</li>
              {{/each}}
            </ul>
          </details>
        {{/if}}
      </div>
    {{/each}}

    {{#if @model.parametrosUrbanisticos.potential}}
      <div style="border-top: 1px solid #ddd; padding-top: 0.75rem; margin-top: 0.75rem;">
        <h5>Potencial teórico pela área cadastral</h5>
        {{#if @model.parametrosUrbanisticos.potential.basicComputableArea}}
          <div class="data-grid">
            <label class="data-label">Área computável pelo CA básico</label>
            <span class="datum">{{numeral-format @model.parametrosUrbanisticos.potential.basicComputableArea "0,0.[00]"}} m²</span>
          </div>
        {{/if}}
        {{#if @model.parametrosUrbanisticos.potential.maximumComputableArea}}
          <div class="data-grid">
            <label class="data-label">Área computável pelo CA máximo</label>
            <span class="datum">{{numeral-format @model.parametrosUrbanisticos.potential.maximumComputableArea "0,0.[00]"}} m²</span>
          </div>
        {{/if}}
        {{#if @model.parametrosUrbanisticos.potential.maximumFootprint}}
          <div class="data-grid">
            <label class="data-label">Projeção máxima pela TO</label>
            <span class="datum">{{numeral-format @model.parametrosUrbanisticos.potential.maximumFootprint "0,0.[00]"}} m²</span>
          </div>
        {{/if}}
        {{#if @model.parametrosUrbanisticos.potential.minimumPermeableArea}}
          <div class="data-grid">
            <label class="data-label">Área permeável mínima</label>
            <span class="datum">{{numeral-format @model.parametrosUrbanisticos.potential.minimumPermeableArea "0,0.[00]"}} m²</span>
          </div>
        {{/if}}
        <p class="text-small medium-gray">
          {{@model.parametrosUrbanisticos.potential.disclaimer}}
        </p>
      </div>
    {{/if}}

    <p class="text-small medium-gray" style="margin-bottom: 0.25rem;">
      Base legal registrada no LoteDiretor: {{@model.parametrosUrbanisticos.source.law}}, com redação considerada
      pela {{@model.parametrosUrbanisticos.source.amendment}}.
    </p>
    <p class="text-small medium-gray">
      Base jurídica revisada em {{@model.parametrosUrbanisticos.source.reviewedAt}}.
    </p>
  </section>
{{/if}}

{{! template-lint-disable no-whitespace-within-word }}
{{#if @model.usosUrbanisticos.zones.length}}
  <hr class="hide-for-print" />
  <section class="land-use-analysis">
    <h3 class="header-small lot-section-header">
      Usos permitidos — Quadro 4
    </h3>
    <p class="text-small dark-gray">Matriz oficial de usos resolvida para as zonas que incidem no lote. Uma atividade concreta só pode ser concluída após o enquadramento no grupo correto e a aplicação das ressalvas e demais condições legais.</p>

    {{#if @model.usosUrbanisticos.common.conflicts.length}}
      <div style="border-left: 3px solid #d89a2b; padding-left: 0.75rem; margin-bottom: 1rem;">
        <strong>O lote possui zonas com permissões diferentes.</strong>
        <p class="text-small" style="margin-bottom: 0.25rem;">{{@model.usosUrbanisticos.common.conflicts.length}} grupos apresentam conflito entre as zonas incidentes; nesses casos é necessário considerar a parcela do lote atingida por cada zona e a regra aplicável ao projeto.</p>
      </div>
    {{/if}}

    {{#each @model.usosUrbanisticos.zones as |zoneUse|}}
      <div style="margin-bottom: 1.25rem;">
        <h5 style="margin-bottom: 0.35rem;">Zona {{zoneUse.zoneCode}}</h5>
        <p class="text-small medium-gray">
          {{zoneUse.counts.permitted}} permitidos ·
          {{zoneUse.counts.conditional}} com ressalva ·
          {{zoneUse.counts.prohibited}} não permitidos
        </p>

        <details style="margin-bottom: 0.5rem;">
          <summary class="text-small">Ver usos permitidos ({{zoneUse.counts.permitted}})</summary>
          <ul class="text-small">
            {{#each zoneUse.permitted as |use|}}
              <li>
                <strong>{{use.code}}</strong> — {{use.description}}
                {{#if use.installation}}
                  <details style="margin-top: 0.2rem; margin-bottom: 0.35rem;">
                    <summary class="text-small">Condições de instalação — Quadro 4A</summary>
                    <p class="text-small medium-gray" style="margin-bottom: 0.25rem;">{{use.installation.summary}}</p>
                    {{#each use.installation.contextNotes as |conditionNote|}}
                      <p class="text-small medium-gray" style="margin-bottom: 0.2rem;">{{conditionNote}}</p>
                    {{/each}}
                    {{#each use.installation.sourceNotes as |sourceNote|}}
                      <p class="text-small medium-gray" style="margin-bottom: 0.2rem;">{{sourceNote.note}}</p>
                    {{/each}}
                    {{#if use.installation.amendedBy}}
                      <p class="text-small medium-gray" style="margin-bottom: 0.2rem;">Alterado por {{use.installation.amendedBy}}.</p>
                    {{/if}}
                  </details>
                {{/if}}
              </li>
            {{/each}}
          </ul>
        </details>

        {{#if zoneUse.conditional.length}}
          <details style="margin-bottom: 0.5rem;">
            <summary class="text-small">Ver usos com ressalva legal ({{zoneUse.counts.conditional}})</summary>
            <ul class="text-small">
              {{#each zoneUse.conditional as |use|}}
                <li>
                  <strong>{{use.code}}</strong> — {{use.description}}
                  {{#if use.note}}<br /><span class="medium-gray">{{use.note}}</span>{{/if}}
                  {{#if use.installation}}
                    <details style="margin-top: 0.2rem; margin-bottom: 0.35rem;">
                      <summary class="text-small">Condições de instalação — Quadro 4A</summary>
                      <p class="text-small medium-gray" style="margin-bottom: 0.25rem;">{{use.installation.summary}}</p>
                      {{#each use.installation.contextNotes as |conditionNote|}}
                        <p class="text-small medium-gray" style="margin-bottom: 0.2rem;">{{conditionNote}}</p>
                      {{/each}}
                      {{#each use.installation.sourceNotes as |sourceNote|}}
                        <p class="text-small medium-gray" style="margin-bottom: 0.2rem;">{{sourceNote.note}}</p>
                      {{/each}}
                      {{#if use.installation.amendedBy}}
                        <p class="text-small medium-gray" style="margin-bottom: 0.2rem;">Alterado por {{use.installation.amendedBy}}.</p>
                      {{/if}}
                    </details>
                  {{/if}}
                </li>
              {{/each}}
            </ul>
          </details>
        {{/if}}

        <details style="margin-bottom: 0.5rem;">
          <summary class="text-small">Ver usos não permitidos ({{zoneUse.counts.prohibited}})</summary>
          <ul class="text-small">
            {{#each zoneUse.prohibited as |use|}}
              <li><strong>{{use.code}}</strong> — {{use.description}}</li>
            {{/each}}
          </ul>
        </details>
      </div>
    {{/each}}

    <p class="text-small medium-gray">{{@model.usosUrbanisticos.caveat}}</p>
    <p class="text-small medium-gray">{{@model.usosUrbanisticos.installation.caveat}}</p>
    <p class="text-small">
      <span class="pipe">|</span>
    </p>
  </section>
{{/if}}

{{! template-lint-enable no-whitespace-within-word }}

{{#if @model.enquadramentoTerritorial}}
  <hr class="hide-for-print" />
  <section class="territorial-analysis">
    <h3 class="header-small lot-section-header">
      Enquadramento territorial
    </h3>
    <p class="text-small dark-gray">
      Interseções espaciais calculadas pelo LoteDiretor.
      Este bloco confirma incidência geográfica; a interpretação jurídica e os
      parâmetros construtivos serão resolvidos separadamente pelo motor legal.
    </p>

    {{#each @model.enquadramentoTerritorial.displaySections as |section|}}
      <div style="margin-bottom: 1.25rem;">
        <h6 style="margin-bottom: 0.35rem;">{{section.label}}</h6>
        {{#each section.matches as |match|}}
          <div style="border-left: 3px solid #ae561f; padding-left: 0.75rem; margin-bottom: 0.75rem;">
            <strong>{{match.title}}</strong>
            {{#each match.details as |detail|}}
              <div class="data-grid">
                <label class="data-label">{{detail.label}}</label>
                <span class="datum">
                  {{#if detail.url}}
                    <a href={{detail.url}} target="_blank" rel="noopener noreferrer">
                      Abrir documento oficial
                    </a>
                  {{else}}
                    {{detail.value}}
                  {{/if}}
                </span>
              </div>
            {{/each}}
          </div>
        {{/each}}
        <p class="text-small medium-gray" style="margin-bottom: 0;">
          {{section.statusLabel}} · LoteDiretor
        </p>
      </div>
    {{/each}}

    {{#if @model.enquadramentoTerritorial.noIncidence.length}}
      <details style="margin-bottom: 0.75rem;">
        <summary class="text-small">
          Camadas consultadas sem incidência identificada
          ({{@model.enquadramentoTerritorial.noIncidence.length}})
        </summary>
        <ul class="text-small">
          {{#each @model.enquadramentoTerritorial.noIncidence as |label|}}
            <li>{{label}}</li>
          {{/each}}
        </ul>
      </details>
    {{/if}}

    {{#if @model.enquadramentoTerritorial.unavailable.length}}
      <details style="margin-bottom: 0.75rem;">
        <summary class="text-small">
          Camadas indisponíveis na consulta
          ({{@model.enquadramentoTerritorial.unavailable.length}})
        </summary>
        <ul class="text-small">
          {{#each @model.enquadramentoTerritorial.unavailable as |label|}}
            <li>{{label}}</li>
          {{/each}}
        </ul>
      </details>
    {{/if}}

    {{#if @model.siszon.available}}
      {{#if @model.siszon.roadClassification.length}}
        <details style="margin-bottom: 0.75rem;">
          <summary class="text-small">Classificação viária</summary>
          <ul class="text-small">
            {{#each @model.siszon.roadClassification as |road|}}
              <li>{{road.classification}} — {{road.street}} {{#if road.status}}({{road.status}}){{/if}}</li>
            {{/each}}
          </ul>
        </details>
      {{/if}}
      {{#if @model.siszon.zoningHistory.length}}
        <details style="margin-bottom: 0.75rem;">
          <summary class="text-small">Histórico de zoneamento</summary>
          <ul class="text-small">
            {{#each @model.siszon.zoningHistory as |history|}}
              <li>{{history.type}} {{history.perimeter}} · {{history.legislation}} · {{history.status}}</li>
            {{/each}}
          </ul>
        </details>
      {{/if}}
    {{/if}}

    <p class="text-small medium-gray">
      LoteDiretor ·
      Método: {{@model.enquadramentoTerritorial.method}} ·
      CRS de análise: {{@model.enquadramentoTerritorial.analysisCrs}} ·
      Consulta: {{@model.enquadramentoTerritorial.generatedAt}}
    </p>
  </section>
{{/if}}

<hr class="hide-for-print" />
<p class="text-small dark-gray">
  Registro cadastral integrado ao LoteDiretor.
</p>