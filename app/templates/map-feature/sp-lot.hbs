<CartoDataProvider
  @modelId={{this.model.id}}
  @modelName="sp-lot"
  @onLoad={{this.setActiveProperty}} as |lot|
>
  <Mapbox::MapFeatureRenderer @model={{lot}} />
  <Bookmarks::BookmarkButton @bookmarkableModel={{lot}} />
  <LayerRecordViews::SpTaxLot @model={{lot.properties}} />
</CartoDataProvider>
