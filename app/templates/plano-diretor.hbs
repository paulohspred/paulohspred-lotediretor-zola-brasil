<ModuleShell
  @title="Plano Diretor"
  @description="Diagnóstico integrado do terreno para decisões de arquitetura, engenharia e viabilidade."
  as |activeProperty|>
  <h3 class="header-medium">Análise integrada do terreno</h3>
  <p>O Plano Diretor concentra o diagnóstico cadastral, territorial, urbanístico e de risco do imóvel ativo. Topografia, relevo, declividade, drenagem e viabilidade serão incorporados neste mesmo fluxo por etapas.</p>
  <p class="callout secondary text-small">Resultados calculados são apresentados separadamente de regras normativas e documentos comprobatórios.</p>
  <PropertySourceEvidence @propertyId={{activeProperty.id}} />
  <ZoningSourceEvidence @propertyId={{activeProperty.id}} />
  <TerritorialContextEvidence @propertyId={{activeProperty.id}} />
  <PropertyRiskEvidence @propertyId={{activeProperty.id}} />
  <LegalSourceEvidence />
</ModuleShell>
