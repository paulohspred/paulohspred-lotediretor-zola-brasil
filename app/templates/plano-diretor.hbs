<ModuleShell
  @title="Plano Diretor"
  @description="Contexto urbanístico do imóvel com base em camadas e fontes oficiais, sem substituir a leitura da legislação aplicável."
  as |activeProperty|>
  <h3 class="header-medium">Escopo do módulo</h3>
  <p>O shell está preparado para reunir macrozoneamento, macroáreas, eixos, operações urbanas e demais relações territoriais do imóvel ativo com evidência e proveniência.</p>
  <p class="callout secondary text-small">Parâmetros legais somente serão exibidos quando vinculados à fonte normativa correspondente.</p>
  <ZoningSourceEvidence @propertyId={{activeProperty.id}} />
  <TerritorialContextEvidence @propertyId={{activeProperty.id}} />
  <LegalSourceEvidence />
</ModuleShell>
