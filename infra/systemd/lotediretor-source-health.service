[Unit]
Description=LoteDiretor authoritative source health checks
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/srv/lotediretor-zola-brasil
ExecStart=/usr/bin/docker compose -f /srv/lotediretor-zola-brasil/platform-v2/infra/docker/compose.yaml --env-file /srv/lotediretor-zola-brasil/platform-v2/.env --profile health run --rm source-health
PrivateTmp=true
ProtectHome=true
