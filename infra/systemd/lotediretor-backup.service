[Unit]
Description=LoteDiretor platform data backup
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/srv/lotediretor-zola-brasil
Environment=BACKUP_ROOT=/srv/lotediretor-backups
Environment=BACKUP_RETENTION_DAYS=14
ExecStart=/srv/lotediretor-zola-brasil/scripts/backup-platform-v2.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
PrivateTmp=true
ProtectHome=true
